{
  "version": 1,
  "templates": {
    "engineering": {
      "name": "Engineering (Kay's process)",
      "stages": [
        {
          "key": "problem",
          "label": "Problem",
          "hint": "What was wrong, for whom, and why it mattered. Who brought it to us and what constraints we had."
        },
        {
          "key": "research",
          "label": "Initial research",
          "hint": "What we looked at first — observation, interviews, existing products, literature — and what surprised us."
        },
        {
          "key": "needs",
          "label": "Needs",
          "hint": "The user needs we took from the research, turned into measurable specs."
        },
        {
          "key": "brainstorm",
          "label": "Brainstorming",
          "hint": "How we made options (sketches, brainwriting), how many, and how we narrowed them (criteria, matrices)."
        },
        {
          "key": "prototype",
          "label": "Prototyping",
          "hint": "Each mockup round: what it tested, what broke, what we changed."
        },
        {
          "key": "final",
          "label": "Final prototype",
          "hint": "How it works, how it did against the specs, honest shortfalls."
        },
        {
          "key": "next",
          "label": "Future iterations & business model",
          "hint": "What I'd change next and how it could reach people (cost, manufacturing, who pays)."
        }
      ]
    },
    "design": {
      "name": "Design & interaction (proposal)",
      "stages": [
        {
          "key": "premise",
          "label": "Premise",
          "hint": "The idea, the brief or prompt, and the question the piece asks."
        },
        {
          "key": "research",
          "label": "Research & references",
          "hint": "Precedents, references and research that shaped it."
        },
        {
          "key": "concept",
          "label": "Concept",
          "hint": "The core concept and why this one over the alternatives."
        },
        {
          "key": "iterate",
          "label": "Iterations",
          "hint": "Drafts, playtests, pivots: what changed and why."
        },
        {
          "key": "build",
          "label": "Making it",
          "hint": "How it was made: tools, pipeline, craft decisions."
        },
        {
          "key": "final",
          "label": "Final piece",
          "hint": "The finished piece and how people experienced it."
        },
        {
          "key": "next",
          "label": "Reflection & next",
          "hint": "What I learned and what I'd do next."
        }
      ]
    },
    "analytics": {
      "name": "Analytics & strategy (proposal)",
      "stages": [
        {
          "key": "question",
          "label": "The question",
          "hint": "The question in one sentence, and who needed the answer."
        },
        {
          "key": "context",
          "label": "Context",
          "hint": "The client or market situation and the constraints."
        },
        {
          "key": "data",
          "label": "Data",
          "hint": "What data we had, where it came from, and its limits."
        },
        {
          "key": "approach",
          "label": "Approach",
          "hint": "The method we chose and why — and what we rejected."
        },
        {
          "key": "analysis",
          "label": "Analysis",
          "hint": "What the analysis showed: the few numbers that matter."
        },
        {
          "key": "recommendation",
          "label": "Recommendation",
          "hint": "What we recommended and the reasoning."
        },
        {
          "key": "next",
          "label": "What I'd do next",
          "hint": "What I'd test or build next."
        }
      ]
    }
  },
